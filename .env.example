
# Plantilla de variables de entorno. Copia este archivo como ".env" y rellena los valores.
# El archivo .env real contiene secretos y NO se sube al repositorio.

# Contraseña del administrador (root) de MariaDB. Solo para tareas de administración.
MARIADB_ROOT_PASSWORD=change_me

# Base de datos y usuario que usará la aplicación.
MARIADB_DATABASE=movies
MARIADB_USER=movies_app
MARIADB_PASSWORD=change_me

# Puerto de TU ordenador por el que se accede a MariaDB (dentro del contenedor siempre es 3306).
MARIADB_PORT=3307